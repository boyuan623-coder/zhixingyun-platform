# member 服务本地配置示例
# 复制为 application-local.properties

server.port=8001
server.servlet.context-path=/member

spring.application.name=member

spring.datasource.url=jdbc:mysql://127.0.0.1:3306/train_member?characterEncoding=UTF8&autoReconnect=true&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=root
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

mybatis.mapper-locations=classpath:/mapper/**/*.xml
logging.level.com.jiawa.train.member.mapper=trace
